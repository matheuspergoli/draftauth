{
	"name": "@draftauth/core",
	"version": "0.1.0",
	"type": "module",
	"description": "Draft Auth Core",
	"author": "Matheus Pergoli <https://docs.draftauth.com.br>",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"files": ["dist"],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./*": {
			"import": "./dist/*.js",
			"types": "./dist/*.d.ts"
		},
		"./ui/*": {
			"import": "./dist/ui/*.js",
			"types": "./dist/ui/*.d.ts"
		},
		"./package.json": "./package.json"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/matheuspergoli/draftauth.git"
	},
	"bugs": {
		"url": "https://github.com/matheuspergoli/draftauth/issues"
	},
	"license": "MIT",
	"scripts": {
		"build": "tsdown",
		"deploy": "tsup && changeset publish",
		"clean": "rm -rf dist .turbo node_modules"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.4",
		"@draftauth/tsconfig": "workspace:*",
		"@types/node": "^22.15.30",
		"tsdown": "^0.12.7",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@libsql/client": "^0.15.8",
		"@standard-schema/spec": "^1.0.0",
		"hono": "^4.7.11",
		"jose": "^6.0.11"
	}
}
