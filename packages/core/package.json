			"types": "./src/ui/*.tsx"
		}
	},
	"license": "MIT",
	"scripts": {
		"clean": "rm -rf dist .turbo node_modules"
	},
	"devDependencies": {
		"@draftauth/tsconfig": "workspace:*",
		"@types/node": "^22.15.29",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@libsql/client": "^0.15.8",
		"@standard-schema/spec": "^1.0.0",
		"hono": "^4.7.11",
		"jose": "^6.0.11",
		"zod": "^3.25.42"
	}
}
