{
	"name": "@draftauth/core",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		},
		"./*": {
			"import": "./src/*.ts",
			"types": "./src/*.d.ts"
