{
	"name": "@draftauth/core",
	"version": "0.12.0",
	"type": "module",
	"description": "Draft Auth Core",
	"author": "Matheus Pergoli <https://docs.draftauth.com.br>",
	"main": "dist/index.js",
	"typings": "dist/index.d.ts",
	"files": ["src", "dist"],
	"exports": {
		".": {
			"import": "./dist/esm/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./*": {
			"import": "./dist/esm/*.js",
			"types": "./dist/types/*.d.ts"
		},
		"./ui": {
			"import": "./dist/esm/ui/index.js",
			"types": "./dist/types/ui/index.d.ts"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/matheuspergoli/draftauth.git"
	},
	"bugs": {
		"url": "https://github.com/matheuspergoli/draftauth/issues"
	},
	"license": "MIT",
	"scripts": {
		"build": "bun run script/build.ts",
		"deploy": "tsup && changeset publish",
		"clean": "rm -rf dist .turbo node_modules"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.4",
		"@draftauth/tsconfig": "workspace:*",
		"@types/bun": "^1.2.16",
		"@types/node": "^24.0.1",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@libsql/client": "^0.15.9",
		"@standard-schema/spec": "^1.0.0",
		"hono": "^4.7.11",
		"jose": "^6.0.11"
	}
}
